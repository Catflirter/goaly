table inet k3s_guard
delete table inet k3s_guard
table inet k3s_guard {
  set k3s_peers {
    type ipv4_addr
    elements = { @PEERS@ }
  }
  chain input {
    type filter hook input priority -5; policy accept;
    tcp dport { 6443, 10250 } iifname { "lo", "cni0" } accept
    tcp dport { 6443, 10250 } ip saddr @k3s_peers counter accept
    tcp dport { 6443, 10250 } counter drop
  }
  chain forward {
    type filter hook forward priority -5; policy accept;
    ip saddr 10.42.0.0/16 ip daddr 169.254.169.254 meta l4proto { tcp, udp } th dport 53 accept
    ip saddr 10.42.0.0/16 ip daddr 169.254.169.254 counter drop
  }
}
