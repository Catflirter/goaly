# Secrets: they live in the environment or ~/.config/goaly/.env, never in the repository.
.env
.env.*
*.env
.envrc

# Run artifacts, at the top level only.
/runs/

# The RSI ledger the lanes write (spec §8.6). T22 copies its entries to a tracked path such as
# rsi/results/<lane>/ for results PRs, and never adds this live directory with -f.
/rsi/ledger/

# Python and packaging.
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Tool caches and coverage reports.
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
