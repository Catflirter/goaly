#!/usr/bin/env bash
# Run gpuctl (lambda/gpuctl) from the repo's venv with .env loaded: scripts/gpuctl <command> [args...]
set -euo pipefail

# shellcheck disable=SC1091  # common.sh is linted on its own
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
# kubectl must reach this cluster (spec section 11: KUBECONFIG=~/.kube/hybrid-gpu.yaml), never the cluster an
# ambient KUBECONFIG in the operator's shell points at. .env may still set KUBECONFIG explicitly.
unset KUBECONFIG
load_env
export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/hybrid-gpu.yaml}"
[[ -x "$REPO_ROOT/.venv/bin/python" ]] || die "$REPO_ROOT/.venv/bin/python not found: run make venv"
# -P (safe path, Python >= 3.11): `-m` would otherwise put the caller's cwd first on sys.path, so a stray
# argparse.py or yaml.py there would run with the .env secrets in its environment.
exec env PYTHONPATH="$REPO_ROOT/lambda" "$REPO_ROOT/.venv/bin/python" -P -m gpuctl "$@"
